{
  "name": "Ch5 - Capstone Automated Lead Engine",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "inbound-lead-engine",
        "options": {}
      },
      "id": "032c3c5f-fb69-4e43-8071-7534ae388398",
      "name": "Lead Capture Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -16,
        16
      ],
      "webhookId": "97a9a151-b9cf-4e90-add7-4618e4f31ce8"
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "messages": {
          "values": [
            {
              "content": "Score this B2B lead from 1-100 based on company and inquiry details, assign tier (Enterprise, Growth, Starter), and write a 3-sentence personalized intro email. Return JSON: score, tier, personalized_email.",
              "role": "system"
            },
            {
              "content": "Name: {{ $json.body.name }}\nCompany: {{ $json.body.company }}\nWebsite: {{ $json.body.website }}\nNeed: {{ $json.body.message }}"
            }
          ]
        },
        "jsonOutput": true,
        "options": {}
      },
      "id": "603fd9fe-9faf-4c2f-b53d-1a95e65806c1",
      "name": "AI Lead Scoring & Copywriter",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.6,
      "position": [
        256,
        16
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_WITH_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Master_CRM",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Name": "={{ $('Lead Capture Webhook').item.json.body.name }}",
            "Email": "={{ $('Lead Capture Webhook').item.json.body.email }}",
            "Company": "={{ $('Lead Capture Webhook').item.json.body.company }}",
            "Score": "={{ $json.message.content.score }}",
            "Tier": "={{ $json.message.content.tier }}",
            "Status": "Contacted"
          }
        },
        "options": {}
      },
      "id": "dd97d11b-29a8-4afe-bfc4-52a9ff6c8453",
      "name": "Log Lead to Master CRM",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        512,
        16
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $('Lead Capture Webhook').item.json.body.email }}",
        "subject": "Quick idea for {{ $('Lead Capture Webhook').item.json.body.company }}",
        "message": "={{ $('AI Lead Scoring & Copywriter').item.json.message.content.personalized_email }}",
        "options": {}
      },
      "id": "8dbe9d2e-820a-41ac-8dc2-04a2363516a0",
      "name": "Send Personalized Outreach",
      "type": "n8n-nodes-base.gmail",
