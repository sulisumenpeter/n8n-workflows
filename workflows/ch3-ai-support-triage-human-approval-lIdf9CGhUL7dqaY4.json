{
  "name": "Ch3 - AI Support Triage & Human Approval",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "support-ticket",
        "options": {}
      },
      "id": "3b84e19d-2b0b-41f9-84a5-9e8a927d2b36",
      "name": "Incoming Support Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        128
      ],
      "webhookId": "25e671bc-9fab-41ff-8e69-ba0f7143d60f"
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "messages": {
          "values": [
            {
              "content": "Classify the support ticket and draft a helpful reply. Output valid JSON with keys: category (Billing, Technical, General), urgency (High, Normal), confidence (0-100), draft_reply.",
              "role": "system"
            },
            {
              "content": "Customer: {{ $json.body.customer_email }}\nMessage: {{ $json.body.message }}"
            }
          ]
        },
        "jsonOutput": true,
        "options": {}
      },
      "id": "d80b3788-2319-4562-a4d6-4584ef98feae",
      "name": "AI Triage & Draft Reply",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.6,
      "position": [
        272,
        128
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "cond-1",
              "leftValue": "={{ $json.message.content.urgency }}",
              "rightValue": "High",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "f16dcc17-6cd1-462d-9310-d8e4063f3b84",
      "name": "Requires Human Approval?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        528,
        128
      ]
    },
    {
      "parameters": {
        "sendTo": "support-manager@yourdomain.com",
        "subject": "[APPROVAL NEEDED] {{ $json.message.content.category }} Ticket",
        "message": "Customer: {{ $('Incoming Support Webhook').item.json.body.customer_email }}\n\nProposed Reply:\n{{ $json.message.content.draft_reply }}",
        "options": {}
      },
      "id": "b51973c3-bc53-4ccd-a5fd-3bf99fc84e75",
      "name": "Send to Manager for Approval",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        800,
        0
      ],
      "webhookId": "1fedc7bf-d909-4248-b9dc-3d3228aed6ce"
    },
    {
      "parameters": {
        "sendTo": "={{ $('Incoming Support Webhook').item.json.body.customer_email }}",
        "subject": "Re: Your Support Request",
        "message": "={{ $json.message.content.draft_reply }}",
        "options": {}
      },
      "id": "6e035313-87dc-4de7-9b32-c907227673ad",
      "name": "Send Auto-Reply",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        800,
        240
      ],
      "webhookId": "3592c728-90a5-4d1c-b748-285e544b080b"
    }
  ],
  "connections": {
    "Incoming Support Webhook": {
      "main": [
        [
          {
            "node": "AI Triage & Draft Reply",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AI Triage & Draft Reply": {
      "main": [
        [
          {
            "node": "Requires Human Approval?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Requires Human Approval?": {
      "main": [
        [
          {
            "node": "Send to Manager for Approval",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send Auto-Reply",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "binaryMode": "separate"
  },
  "tags": []
}